{
  "name": "@hao-nx-toolkit/project-boundary",
  "version": "0.0.1",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@org/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "executors.json",
    "generators.json",
    "LICENSE"
  ],
  "nx": {
    "name": "project-boundary",
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/project-boundary/dist",
          "main": "packages/project-boundary/src/index.ts",
          "tsConfig": "packages/project-boundary/tsconfig.lib.json",
          "rootDir": "packages/project-boundary/src",
          "generatePackageJson": false,
          "assets": [
            {
              "input": "./packages/project-boundary/src",
              "glob": "**/!(*.ts)",
              "output": "."
            },
            {
              "input": "./packages/project-boundary/src",
              "glob": "**/*.d.ts",
              "output": "."
            }
          ]
        }
      }
    },
    "tags": [
      "kind:workspace",
      "role:production"
    ]
  },
  "dependencies": {
    "@nx/devkit": "23.2.0",
    "tslib": "^2.3.0"
  },
  "executors": "./executors.json",
  "generators": "./generators.json",
  "devDependencies": {
    "nx": "23.2.0"
  },
  "peerDependencies": {
    "nx": "23.2.0"
  },
  "description": "Tag-based project dependency boundary checks for Nx workspaces.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hao0731/hao-nx-toolkit.git",
    "directory": "packages/project-boundary"
  },
  "homepage": "https://github.com/hao0731/hao-nx-toolkit/tree/main/packages/project-boundary#readme",
  "bugs": {
    "url": "https://github.com/hao0731/hao-nx-toolkit/issues"
  },
  "keywords": [
    "nx",
    "nx-plugin",
    "monorepo",
    "dependency-boundaries",
    "project-graph"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
