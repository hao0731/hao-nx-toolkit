{
  "name": "@hao-nx-toolkit/golang",
  "version": "0.3.0",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@org/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "generators.json",
    "LICENSE"
  ],
  "nx": {
    "name": "golang",
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "packages/golang/dist",
          "main": "packages/golang/src/index.ts",
          "tsConfig": "packages/golang/tsconfig.lib.json",
          "rootDir": "packages/golang/src",
          "generatePackageJson": false,
          "assets": [
            {
              "input": "./packages/golang/src",
              "glob": "**/!(*.ts)",
              "output": "."
            },
            {
              "input": "./packages/golang/src",
              "glob": "**/*.d.ts",
              "output": "."
            }
          ]
        }
      }
    },
    "tags": [
      "lang:golang",
      "role:production"
    ]
  },
  "dependencies": {
    "@nx/devkit": "24.0.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "nx": "24.0.0"
  },
  "peerDependencies": {
    "nx": "^23.2.0 || ^24.0.0"
  },
  "generators": "./generators.json",
  "description": "Go model, config, service, repository, and handler generators for Nx workspaces.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hao0731/hao-nx-toolkit.git",
    "directory": "packages/golang"
  },
  "homepage": "https://github.com/hao0731/hao-nx-toolkit/tree/main/packages/golang#readme",
  "bugs": {
    "url": "https://github.com/hao0731/hao-nx-toolkit/issues"
  },
  "keywords": [
    "nx",
    "nx-plugin",
    "go",
    "golang",
    "generators",
    "gin",
    "echo"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
