{
  "name": "project-boundary-e2e",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "projectType": "application",
    "sourceRoot": "e2e/project-boundary-e2e/src",
    "implicitDependencies": [
      "project-boundary"
    ],
    "tags": [
      "kind:workspace",
      "role:testing"
    ],
    "targets": {
      "e2e": {
        "executor": "nx:run-commands",
        "cache": false,
        "dependsOn": [
          "^build"
        ],
        "options": {
          "command": "vitest",
          "cwd": "e2e/project-boundary-e2e"
        }
      },
      "test": {
        "cache": false,
        "dependsOn": [
          "^build"
        ]
      }
    }
  },
  "type": "module"
}
